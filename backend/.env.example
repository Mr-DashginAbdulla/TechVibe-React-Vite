# Server Configuration
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/techvibe
NODE_ENV=development

# SMTP Configuration (Brevo / SendGrid / Gmail)
# Sign up at https://www.brevo.com for free 300 emails/day
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_login@example.com
SMTP_PASS=your_smtp_key_here
SMTP_FROM="TechVibe" <noreply@techvibe.com>

# Firebase Storage
# Find this in Firebase Console > Storage > gs://YOUR_BUCKET
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
